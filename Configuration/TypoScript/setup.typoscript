// ---------------------------------------------------------------------------------------------------------------------
// Container mit zwei und drei Spalten (b13/container)
tt_content {
  ps14_container_2_column =< lib.contentElement
  ps14_container_2_column {
    templateName = ContainerTwoColumn

    templateRootPaths {
      50 = EXT:ps14_container/Resources/Private/Templates/Content/
    }

    partialRootPaths {
      50 = EXT:ps14_container/Resources/Private/Partials/
    }

    dataProcessing {
      4001 = B13\Container\DataProcessing\ContainerProcessor
      4001 {
        colPos = 4001
        as = columnOne
        skipRenderingChildContent = 1
      }

      4002 < .4001
      4002 {
        colPos = 4002
        as = columnTwo
      }
    }
  }

  ps14_container_3_column =< lib.contentElement
  ps14_container_3_column {
    templateName = ContainerThreeColumn

    templateRootPaths {
      50 = EXT:ps14_container/Resources/Private/Templates/Content/
    }

    partialRootPaths {
      50 = EXT:ps14_container/Resources/Private/Partials/
    }

    dataProcessing {
      4001 = B13\Container\DataProcessing\ContainerProcessor
      4001 {
        colPos = 4001
        as = columnOne
        skipRenderingChildContent = 1
      }

      4002 < .4001
      4002 {
        colPos = 4002
        as = columnTwo
      }

      4003 < .4001
      4003 {
        colPos = 4003
        as = columnThree
      }
    }
  }
}
